# OPENAI_API_KEY: Required for OpenAI API integration with Chemist AI Assistant.
# Store securely on the backend server. Never expose in frontend code.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# GEMINI_API_KEY: Optional fallback for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
